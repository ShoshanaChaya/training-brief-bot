# Copy this file to .env for local runs.
# In GitHub Actions, set each of these as a repository secret instead.

# === Google Gemini API ===
# Get one (free) at https://aistudio.google.com/app/apikey — no card required.
# Free tier: ~1500 requests/day on gemini-2.5-flash.
GEMINI_API_KEY=...

# === Garmin Connect (unofficial — your real login) ===
# These are your normal Garmin Connect credentials.
# Used by the python-garminconnect library.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# === Resend (email delivery) ===
# Get one at https://resend.com/ — free tier: 100 emails/day, no domain needed.
RESEND_API_KEY=re_...

# === Email destination ===
# The address that receives the daily briefing.
EMAIL_TO=huckhprj@gmail.com

# Sender address. Use "onboarding@resend.dev" for the free tier (no domain
# verification required). If you verify a domain in Resend, use
# "coach@yourdomain.com" instead.
EMAIL_FROM=Workout Coach <onboarding@resend.dev>
